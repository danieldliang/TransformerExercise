   "source": [
    "PAT = r\"\"\"'(?:[sdmt]|ll|ve|re)| ?\\p{L}+| ?\\p{N}+| ?[^\\s\\p{L}\\p{N}]+|\\s+(?!\\S)|\\s+\"\"\"\n",
    "import regex as re\n",
    "print(re.findall(PAT, \"some text that I'll pretokenize. H\"))\n",
    "a = re.finditer(PAT, \"some\")\n",
    "for m in a:\n",
    "    print(m.start())\n"
   ]
